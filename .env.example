# =============================================================================
# StockFlow Pro — environment template. Copy to .env.local and fill in.
# NEVER commit real secrets. Placeholder names only in this file.
# =============================================================================

# ---- Supabase (client-safe) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase (SERVER ONLY — never exposed to the browser) ----
# Used only in server actions / route handlers / the setup script.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# ---- Backup encryption (server only) ----
# 32-byte key, base64. Generate: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=YOUR_BASE64_32_BYTE_KEY

# ---- Google Drive backup (server only) ----
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/backups/google/callback
# Refresh tokens are stored ENCRYPTED in the DB, not here.

# ---- Cron / scheduled backup auth (server only) ----
CRON_SECRET=YOUR_RANDOM_CRON_SECRET
