{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StockFlow Pro",
  "version": "1.0.0",
  "identifier": "com.mindtune.stockflowpro",
  "build": {
    "frontendDist": "../desktop-shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Mindtune Innovations",
    "copyright": "© 2026 Mindtune Innovations · Developed by Muhammad Ali, Accounts & Finance Expert, MBA (Finance) · alim2840@gmail.com",
    "category": "Business",
    "shortDescription": "Premium Inventory and Project Management System",
    "longDescription": "StockFlow Pro — Premium Inventory and Project Management System. Published by Mindtune Innovations. Developed by Muhammad Ali, Accounts & Finance Expert, MBA (Finance). Support: alim2840@gmail.com",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "both",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "license": "../release/LICENSE.txt",
        "startMenuFolder": "StockFlow Pro"
      },
      "wix": {
        "language": "en-US"
      }
    }
  },
  "plugins": {}
}
