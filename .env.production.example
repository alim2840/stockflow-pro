# =============================================================================
# StockFlow Pro — PRODUCTION environment template (server deployment only).
# Set these in your hosting provider (e.g. Vercel → Project → Settings →
# Environment Variables). Placeholder names only — never commit real secrets.
#
# END-USER PCs NEED NONE OF THIS. The desktop app only asks for the server
# address on first launch. Secrets live exclusively on the server.
# =============================================================================

# ---- Public (safe to expose to browsers/desktop shell) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_APP_URL=https://stock.yourcompany.com

# ---- Server-only secrets (NEVER shipped to desktops or browsers) ----
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# Backup encryption key (32 bytes, base64). Generate: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=YOUR_BASE64_32_BYTE_KEY

# Google Drive backups (server-side OAuth; tokens stored encrypted in DB)
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_OAUTH_REDIRECT_URI=https://stock.yourcompany.com/api/backups/google/callback

# Scheduled backup cron authentication
CRON_SECRET=YOUR_RANDOM_CRON_SECRET

# CI build stamp (set automatically by the release workflow)
# BUILD_NUMBER=
